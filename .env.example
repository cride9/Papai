# Papai Parts Backend — Environment Configuration
# Copy this to .env and customize.

# ── Paths ──────────────────────────────────────────────────────
# PDF_FOLDER=./pdfs
# DB_URL=sqlite:///databases/catalog_database.sqlite
# CHROMA_PATH=./databases/chroma_text_db_deploy
# CHROMA_COLLECTION=alkatreszek_hu_2048

# ── LLM / Embedding ────────────────────────────────────────────
# EMBED_ENDPOINT=http://26.114.75.255:8081/v1/embeddings
# CHAT_ENDPOINT=http://26.114.75.255:8080/v1/chat/completions
# EMBED_MODEL=qwen3-embedding
# CHAT_MODEL=qwen

# ── Auth (REQUIRED — change these!) ────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Server ─────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
